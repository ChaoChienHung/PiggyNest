# Copy to backend/.env and set real values. Keep backend/.env out of Git.
# All configuration is loaded from environment variables and backend/.env.

# Security: set a stable, random SECRET_KEY in shared/deployed environments.
# SECRET_KEY=
# ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database (defaults to sqlite:///<repo>/data/piggynest.db)
# DATABASE_URL=sqlite:///../data/piggynest.db

# CORS origins as a JSON list when serving a deployed frontend
# ALLOWED_ORIGINS=["http://localhost:5173"]

# Account recovery email (SMTP)
SMTP_HOST=
SMTP_PORT=465
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
